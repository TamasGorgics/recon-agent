      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "recon-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT risk_tier,\n       count(*) FILTER (WHERE status = 'pending_approval')::bigint AS pending,\n       COALESCE(max(pending_seconds) FILTER (WHERE status = 'pending_approval'), 0)::bigint\n           AS oldest_pending_seconds,\n       count(*) FILTER (WHERE decision = 'approved')::bigint AS approved,\n       count(*) FILTER (WHERE decision = 'rejected')::bigint AS rejected,\n       ROUND(percentile_cont(0.5) WITHIN GROUP (ORDER BY approval_seconds)\n             FILTER (WHERE decision = 'approved' AND $__timeFilter(approved_at)))::bigint\n           AS median_approval_seconds,\n       ROUND(percentile_cont(0.95) WITHIN GROUP (ORDER BY approval_seconds)\n             FILTER (WHERE decision = 'approved' AND $__timeFilter(approved_at)))::bigint\n           AS p95_approval_seconds\nFROM v_ops_approval_queue\nGROUP BY risk_tier\nORDER BY risk_tier;",
          "refId": "A"
        }
      ],
      "title": "Approval queue",
      "type": "table"
    },
