          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT break_type, bucket, count(*)::bigint AS breaks,\n       SUM(abs(delta_minor))::bigint AS exposure_minor\nFROM v_ops_break_aging\nGROUP BY break_type, bucket, bucket_order\nORDER BY break_type, bucket_order;",
