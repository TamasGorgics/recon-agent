# Local development values only. Never put real secrets in this file.
# RECON_ENV must be production outside local/dev: `recon demo --reset` refuses
# to run only when RECON_ENV=production, and it drops schemas.
RECON_ENV=development
DATABASE_URL=postgres://recon:recon@localhost:5432/recon?sslmode=disable
TEST_DATABASE_URL=postgres://recon:recon@localhost:5432/recon?sslmode=disable
DATABASE_APP_URL=
DATABASE_AGENT_URL=
LOG_LEVEL=info
CONFIG_FILE=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=
API_KEYS=
POLICY_FILE=
