# Local development values only. Never put real secrets in this file.
# RECON_ENV must be production outside local/dev: `recon demo --reset` refuses
# to run only when RECON_ENV=production, and it drops schemas.
RECON_ENV=development
DATABASE_URL=postgres://recon:recon@localhost:5432/recon?sslmode=disable
TEST_DATABASE_URL=postgres://recon:recon@localhost:5432/recon?sslmode=disable
DATABASE_APP_URL=
DATABASE_AGENT_URL=
LOG_LEVEL=info
CONFIG_FILE=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_MODEL=
API_KEYS=
POLICY_FILE=
# Slack (M4-12). The bot token and signing secret are env-only; never put them
# in the YAML config. SLACK_CHANNEL_ID and SLACK_CASE_FILE_BASE_URL may also be
# set in the slack YAML block.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_CASE_FILE_BASE_URL=
# Prometheus metrics listeners (M5-03). Defaults are loopback; the API serves
# metrics on its existing address and does not use these two keys.
METRICS_WORKER_ADDR=127.0.0.1:9091
METRICS_OUTBOX_ADDR=127.0.0.1:9092
